{
  "name": "@notecms/sdk",
  "version": "0.5.0",
  "private": false,
  "description": "NoteCMS headless SDK: GraphQL client, build snapshots, and permalink routing for static sites. Routing guide: docs/ROUTING.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build -w @notecms/routing && tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@notecms/routing": "*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  }
}
