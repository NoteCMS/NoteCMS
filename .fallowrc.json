{
  "$schema": "https://docs.fallow.tools/schemas/config.schema.json",
  "boundaries": {
    "zones": [
      { "name": "appsApi", "patterns": ["apps/api/src/**"] },
      { "name": "appsWeb", "patterns": ["apps/web/src/**"] },
      { "name": "packages", "patterns": ["packages/**"] }
    ],
    "rules": [
      {
        "from": "packages",
        "allow": ["packages"],
        "reason": "Packages may only import other packages."
      },
      {
        "from": "appsApi",
        "allow": ["packages"],
        "reason": "API app may import packages only."
      },
      {
        "from": "appsWeb",
        "allow": ["packages"],
        "reason": "Web app may import packages only."
      }
    ]
  }
}
