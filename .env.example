NODE_ENV=development
JWT_SECRET=change-me

# First admin: created on API startup without a password; complete password in the login UI (or via GraphQL setInitialPassword).
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# Optional: if set, the “Setup key” field is required when choosing the initial password.
# BOOTSTRAP_SECRET=generate-a-long-random-string

MONGO_URI=mongodb://mongo:27017/notecms
API_PORT=4000
WEB_PORT=5173
ASSET_STORAGE_DRIVER=local
ASSET_LOCAL_ROOT=./data/assets
# Public CDN for asset URLs (required for s3 driver; recommended for live sites)
# ASSET_CDN_BASE_URL=https://assets.example.com
# Optional public origin for local storage without a separate CDN (defaults to PUBLIC_API_BASE_URL/api/assets)
# ASSET_PUBLIC_BASE_URL=https://api.example.com/api/assets
# S3-compatible storage (Cloudflare R2, AWS S3, MinIO)
# ASSET_S3_BUCKET=notecms-assets
# ASSET_S3_REGION=auto
# ASSET_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
# ASSET_S3_FORCE_PATH_STYLE=false
BACKUP_LOCAL_ROOT=./data/backups
# Platform-wide mongodump backups (off in dev by default; requires mongodb-database-tools on PATH)
# PLATFORM_BACKUP_ENABLED=true
# MONGODUMP_BIN=mongodump
# MONGORESTORE_BIN=mongorestore
# BACKUP_SCHEDULER_ENABLED=true
# BACKUP_CRON_HOURLY=0 * * * *
# BACKUP_CRON_DAILY=0 3 * * *
# BACKUP_CRON_WEEKLY=0 4 * * 0
ASSET_MAX_UPLOAD_BYTES=10000000

# API hardening (production): comma-separated admin UI origins; trust proxy when behind nginx/Portless (required if X-Forwarded-For is set). Defaults on in development; set explicitly in production.
# CORS_ORIGINS=https://cms.example.com
# TRUST_PROXY=1
# TRUST_PROXY=0
# JSON_BODY_LIMIT=12mb

# GitHub publish PAT encryption: optional; if unset, JWT_SECRET is used (one secret for typical installs).
# PUBLISH_WEBHOOK_ENCRYPTION_KEY=
# Public API origin (no trailing slash) for workflow callback URLs, e.g. https://api.example.com
# PUBLIC_API_BASE_URL=
# DISPATCH_CALLBACK_TTL_HOURS=168
# Rate limit for POST /api/hooks/site-build/:siteId (legacy /hooks/site-build/:siteId also supported)
# HOOKS_RATE_LIMIT_MAX=120
# HOOKS_RATE_LIMIT_WINDOW_MS=900000
# MCP /api/mcp — unauthenticated probes only (default 60 / 15 min per IP); authenticated calls are not limited
# MCP_RATE_LIMIT_UNAUTH_MAX=60
# MCP_RATE_LIMIT_WINDOW_MS=900000
# MCP_RATE_LIMIT_UNAUTH_MAX=0 disables MCP rate limiting

# Optional: extra CSP connect-src origins for the static web container (space or comma separated)
# CSP_CONNECT_SRC_EXTRA=https://api.other.example

# --- Transactional email (password reset, user invites) ---
# Set MAIL_ENABLED=true and configure SMTP on the API service. PUBLIC_URL must be the browser-reachable admin UI origin (no trailing slash).
# MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=NoteCMS <noreply@example.com>
# MAIL_TOKEN_TTL_RESET_MINUTES=60
# MAIL_TOKEN_TTL_INVITE_HOURS=168
# MAIL_RATE_LIMIT_MAX=3
# MAIL_RATE_LIMIT_WINDOW_MS=3600000

# --- deploy/docker-compose.yml (production images) ---
# NOTECMS_API_IMAGE=ghcr.io/your-org/notecms-api:v1.0.0
# NOTECMS_WEB_IMAGE=ghcr.io/your-org/notecms-web:v1.0.0
# Same-origin behind a reverse proxy:
# PUBLIC_URL=https://cms.example.com
# GRAPHQL_PATH=/graphql
# Same host/protocol as the UI, API on another port (recommended on a server — no hardcoded hostname):
# NOTECMS_GRAPHQL_PORT=4000
# Or full browser-reachable GraphQL URL (highest priority; overrides PUBLIC_URL and NOTECMS_GRAPHQL_PORT):
# NOTECMS_GRAPHQL_URL=https://api.example.com/graphql
# Local dev (Vite): optional port-only mode matching docker entrypoint behavior:
# VITE_GRAPHQL_PORT=4000
# Optional host bindings (defaults bind localhost only):
# API_PUBLISH_PORT=127.0.0.1:4000
# WEB_PUBLISH_PORT=127.0.0.1:5173
