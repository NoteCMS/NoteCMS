# Loaded when running `vite --mode portless` (see apps/web/package.json `dev:portless`).
# Ensures the GraphQL proxy works even if the parent shell (e.g. portless) does not forward env vars.
VITE_USE_GRAPHQL_PROXY=true
# Vite dev proxy target: loopback API port (must match API_PORT in dev:portless). Do not use https://api.notecms.localhost — Node rejects Portless self-signed TLS.
NOTECMS_PORTLESS_API=http://127.0.0.1:4000
